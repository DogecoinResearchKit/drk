# Chain selection: "bitcoin", "litecoin", or "dogecoin"
CHAIN=dogecoin

# Path to the blockchain node's data directory
# Bitcoin:  CHAIN_DATA_DIR=/path/to/bitcoin
# Dogecoin (macOS): CHAIN_DATA_DIR="/Users/you/Library/Application Support/Dogecoin"
CHAIN_DATA_DIR="/path/to/dogecoin"

# RPC connection settings (use host.docker.internal when dogecoind runs on the Mac host)
# Dogecoin mainnet RPC port is 22555.
RPC_HOST=host.docker.internal
RPC_USER=dogecoin
RPC_PASSWORD=dogecoin

# BRK index + computed data (bind-mount preserves index across container rebuilds)
BRK_DATA_DIR=/Users/you/.brk
